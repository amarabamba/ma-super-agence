.git
.idea
.vscode
**/.DS_Store
.github

# Dependencies (rebuilt inside the image)
vendor
node_modules

# Generated / build artifacts (rebuilt inside the image)
public/build
public/media/cache
var

# Config generated by console commands
config/reference.php

# Tests (dev only)
tests

# Secrets: never copy local environment overrides.
# .env (committed dev defaults) MUST stay: Symfony 8.1 throws a Dotenv
# PathException if /app/.env is absent (bootEnv fails hard, the app won't boot).
# Real environment variables (Render/Compose) always win over it.
.env.*
!.env.example

# Runtime uploads are ephemeral / provided at runtime — keep only the placeholder
public/assets/images/properties/*
!public/assets/images/properties/placeholder.jpg