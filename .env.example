# Copie de référence pour un déploiement (Render, Docker, autre hébergeur).
# Renseignez ces variables dans l'interface de votre hébergeur — JAMAIS dans un fichier commité.

# --- Environnement -------------------------------------------------------------
APP_ENV=prod
APP_DEBUG=0

# --- Sécurité ----------------------------------------------------------------
# Obligatoire. Générez une valeur aléatoire unique :  php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=replace_me_with_the_secret_generated_above

# --- Base de données ----------------------------------------------------------
# Render ne fournit PAS de MySQL managé. Utilisez un MySQL externe
# (ex. Clever Cloud, TiDB Cloud Serverless, Aiven...) et son URL de connexion ici.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME

# Les migrations sont exécutées automatiquement au démarrage du conteneur
# (docker/docker-entrypoint.sh).

# --- Mailer --------------------------------------------------------------------
# null://null avale simplement les mails (pratique pour tester). En production,
# utilisez un DSN SMTP (ex. Mailtrap, Brevo, Mailgun...).
MAILER_DSN=null://null
# Exemple : smtp://user:pass@smtp.example.com:465?encryption=ssl

# --- Serveur --------------------------------------------------------------------
# Port HTTP. Render injecte automatiquement la variable PORT au moment du déploiement.
# Sert uniquement si vous exécutez le conteneur en local sans -e PORT.
# PORT=8080