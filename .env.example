# Copie de référence pour un déploiement sur Railway (variables d'environnement).
# Renseignez ces variables dans l'onglet "Variables" du service Railway —
# JAMAIS dans un fichier commité.

# --- Environnement -------------------------------------------------------------
APP_ENV=prod
APP_DEBUG=0

# --- Sécurité ----------------------------------------------------------------
# Obligatoire. Générez une valeur aléatoire unique :
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=replace_me_with_the_secret_generated_above

# --- Base de données ----------------------------------------------------------
# Railway ne fournit pas de MySQL managé. Utilisez un MySQL externe (ex. Aiven)
# et collez ici l'URL de connexion fournie par l'hébergeur.
# Les migrations sont exécutées automatiquement au démarrage (start-container.sh).
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME

# --- Mailer --------------------------------------------------------------------
# null://null avale simplement les mails. En production,
# utilisez un DSN SMTP (ex. Brevo, Mailgun, Mailtrap...).
MAILER_DSN=null://null
# Exemple : smtp://user:pass@smtp.example.com:465?encryption=ssl

# --- Railway (Railpack / FrankenPHP) ------------------------------------------
# PORT est injecté automatiquement par Railway au moment du déploiement.
# RAILPACK_PHP_ROOT_DIR=/app/public   # racine web Symfony (public/) servie par FrankenPHP
# COMPOSER_ALLOW_SUPERUSER=1          # permet à Composer de tourner en root (plugins Flex)