# Copie de référence pour un déploiement Docker (Railway / Render) —
# variables d'environnement. Renseignez-les dans votre service cloud
# (ou via docker run -e / docker compose environment) — JAMAIS dans un fichier commité.

# --- Environnement ---------------------------------------------------------------
APP_ENV=prod
APP_DEBUG=0

# --- Sécurité --------------------------------------------------------------------
# Obligatoire. Générez une valeur aléatoire unique :
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=replace_me_with_the_secret_generated_above

# --- Base de données (externe, requise en production) ------------------------------
# MySQL/Postgres managé (Aiven, PlanetScale...) ou VM dédiée.
# Les migrations sont exécutées automatiquement à chaque démarrage du conteneur.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME

# --- Mailer -----------------------------------------------------------------------
# null://null avale silencieusement les mails. En production,
# utilisez un DSN SMTP (ex. Brevo, Mailgun, Mailtrap...).
MAILER_DSN=null://null
# Exemple : smtp://user:pass@smtp.example.com:465?encryption=ssl

# --- Docker / plateforme -----------------------------------------------------------
# PORT est injecté automatiquement par Railway/Render. Localement :
#   docker run -p 8080:8080 -e PORT=8080 ...
# PORT=8080