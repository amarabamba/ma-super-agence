{% extends 'base.html.twig' %}

{% block title 'Agence Lorem Ipsum' %}

{% block body %}
    <div class="jumbotron text-center">
        <h1>Agence Lorem Ipsum</h1>
        <p>Lorem ipsum dolor, sit amet consectetur adipisicing elit. Dolores molestias natus esse aliquam quaerat pariatur dicta, velit animi reprehenderit, quia doloribus repellat culpa corporis harum ad laborum aut expedita maxime.</p>
    </div>

    <div class="container">
        <h2>Les derniers biens</h2>
        <div class="row flex">
            {%  for property in properties %}
               <div class="col-3">
                   <div class="card">
                       <img src="{{ property.imageUrl(360, 230) }}" alt="{{ property.title }}"
                            onerror="this.onerror=null;this.src='{{ asset('/assets/images/properties/placeholder.jpg') }}';"
                            style="width: 100%; height: auto">
                       <div class="card-body">
                           <h5 class="card-title">
                                <a href="{{ path('property.show', {id: property.id, slug: property.slug}) }}">{{ property.title }}</a>
                           </h5>
                           <p class="card-text">{{ property.city }} ({{ property.postalCode }})</p>
                           <div class="text-primary" style="font-weight: bold; font-size:2rem">{{ property.formattedPrice }} £</div>
                       </div>
                   </div>
               </div> 
            {% endfor %}
        </div>
    </div>
{% endblock %}